#!/usr/bin/env bash
# Wrapper: everything this used to do lives in tero.py now (see the comment
# at the top of that file). The only thing left that has to be bash is
# finding the repo when this script is reached through a symlink -- the
# README suggests `ln -s "$PWD/tero" ~/.local/bin/tero` -- because `readlink
# -f` does not exist on older macOS and `dirname "$0"` gives the directory
# of the symlink, not of the repo.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
cd "$(cd -P "$(dirname "$SOURCE")" && pwd)" || exit 1

# `exec` and not a plain call: the pid systemd (and the terminal) sees is
# this one, and after the exec it is uv's. That is fine -- uv forwards
# SIGINT and SIGTERM to the python it runs, verified on macOS with uv
# 0.12.15 -- so `systemctl stop` and Ctrl+C still reach tero.py.
exec uv run python tero.py "$@"
