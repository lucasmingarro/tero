# Systemd user service for Tero. It closes the pending item noted in
# CLAUDE.md ("Servicio: systemd user, no configurado todavía") and gives the
# GNOME settings menu (soul-connector-gnome/panel.js) something stable to
# send start/stop/restart to -- before this, every restart during
# development was pkill + nohup by hand, fragile and with no way to query
# the state from another process.
#
# Installation (see INSTALACIONES.md):
#   ln -s ~/proyectos/tero/systemd/tero.service ~/.config/systemd/user/tero.service
#   systemctl --user daemon-reload
#   systemctl --user start tero      # start now
#   systemctl --user enable tero     # optional: start on every login
#
# ./tero already handles shutdown signals properly (a trap on INT/TERM that
# stops the daemon and the classic soul-connector when applicable) and does
# not need a terminal -- which is why ExecStart points straight at the usual
# script, instead of duplicating its startup/logging logic here.

[Unit]
Description=Tero (asistente de voz push-to-talk)
# This is not an early system boot service: it needs the session bus,
# PipeWire and (if the GNOME extension is enabled) gnome-shell itself
# already running, so the soul-connector has something to connect to.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/proyectos/tero
ExecStart=%h/proyectos/tero/tero
# Never restart on its own: if health.py shut down over critical RAM (exit
# code 3) or the daemon crashed on a real bug, reviving it automatically
# would repeat the same problem instead of letting the user see it and
# decide. The same criterion already documented for health.py: warn, do not
# self-heal.
Restart=no
# KillMode=process (not systemd's default "control-group"): the default
# sends the shutdown signal to the WHOLE service cgroup, and Chrome (the
# dedicated YouTube window, tools/_youtube_screen.py) sits in there as a
# child of the daemon -- a service restart took it down with it (confirmed
# live: the user was watching a channel and it closed on him when Tero was
# restarted over a prompt change). `./tero` already knows how to close its
# own real children (daemon, classic soul-connector) with its own INT/TERM
# trap -- systemd does not need to kill extra on top.
KillMode=process

[Install]
WantedBy=graphical-session.target
